<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tinycast.PaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <Border x:Name="OpaqueFill" />
        <Border x:Name="Frost" />
        <Border x:Name="Scrim" BorderThickness="0" />
        <Grid x:Name="BodySplit" Canvas.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="SplitColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                x:Name="ListScroll"
                Grid.Column="0"
                Padding="8,64,8,60"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowHost" />
            </ScrollViewer>
            <Border
                x:Name="SplitHairline"
                Grid.Column="1"
                Width="1"
                Margin="0,64,0,52"
                Visibility="Collapsed" />
            <Grid
                x:Name="PreviewHost"
                Grid.Column="2"
                Margin="12,64,12,52"
                Visibility="Collapsed" />
        </Grid>
        <StackPanel
            x:Name="EmptyState"
            Canvas.ZIndex="1"
            Margin="0,80,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold" Text="Clipboard History" />
            <TextBlock x:Name="EmptyBody" FontSize="13" Text="Try another name, or open Settings from the tray." />
        </StackPanel>
        <Grid Canvas.ZIndex="3" Height="64" Padding="16,10" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="SearchGlyph"
                Grid.Column="0"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE721;" />
            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Width="28"
                Height="28"
                MinWidth="0"
                MinHeight="0"
                Margin="0,0,10,0"
                Padding="0"
                VerticalAlignment="Center"
                BorderThickness="0"
                Click="OnBackClick"
                Visibility="Collapsed"
                UseSystemFocusVisuals="False">
                <FontIcon x:Name="BackGlyph" FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBox
                x:Name="QueryBox"
                Grid.Column="1"
                MinHeight="0"
                Padding="0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                FontSize="20"
                IsSpellCheckEnabled="False"
                PlaceholderText="Search">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <Thickness x:Key="TextControlThemePadding">0</Thickness>
                    <x:Double x:Key="TextControlMinHeight">0</x:Double>
                    <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                </TextBox.Resources>
            </TextBox>
            <TextBlock
                x:Name="TabHint"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Text="Tab  Clipboard" />
        </Grid>
        <Grid
            x:Name="FooterBar"
            Canvas.ZIndex="3"
            Height="52"
            Padding="12,0"
            VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="MenuCircle"
                Grid.Column="0"
                Width="36"
                Height="36"
                MinWidth="0"
                MinHeight="0"
                Margin="0"
                Padding="0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderThickness="0"
                CornerRadius="18"
                UseSystemFocusVisuals="False">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="OnSettingsClick" Text="Settings" />
                        <MenuFlyoutItem Click="OnQuitClick" Text="Quit Tinycast" />
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon x:Name="MenuGlyph" FontSize="14" Glyph="&#xE712;" />
            </Button>
            <Border
                x:Name="ActionCapsule"
                Grid.Column="2"
                Padding="4"
                VerticalAlignment="Center"
                CornerRadius="18">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="OpenButton"
                        Height="28"
                        MinWidth="0"
                        MinHeight="0"
                        Margin="0"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        Click="OnOpenClick"
                        CornerRadius="14"
                        UseSystemFocusVisuals="False">
                        <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="FooterLabel"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                LineHeight="16"
                                Text="Open" />
                            <Border
                                x:Name="EnterKeyCap"
                                MinWidth="18"
                                Height="18"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                CornerRadius="6"
                                BorderThickness="1">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="↵" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ActionsButton"
                        Height="28"
                        MinWidth="0"
                        MinHeight="0"
                        Margin="0"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        CornerRadius="14"
                        UseSystemFocusVisuals="False"
                        Visibility="Collapsed">
                        <Button.Flyout>
                            <MenuFlyout x:Name="ActionsFlyout" Opening="OnActionsFlyoutOpening" />
                        </Button.Flyout>
                        <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="ActionsLabel"
                                VerticalAlignment="Center"
                                FontSize="13"
                                LineHeight="16"
                                Text="Actions" />
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Border
                                    x:Name="CtrlKeyCap"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="6"
                                    BorderThickness="1">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="Ctrl" />
                                </Border>
                                <Border
                                    x:Name="KKeyCap"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="6"
                                    BorderThickness="1">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="K" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
