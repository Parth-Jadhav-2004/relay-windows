<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tinycast.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tinycast Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Padding="12,16" Spacing="4">
            <TextBlock
                Margin="8,0,8,12"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Tinycast" />
            <Button x:Name="GeneralNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnGeneralNav" Content="General" />
            <Button x:Name="PermissionsNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnPermissionsNav" Content="Permissions" />
            <Button x:Name="FeaturesNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnFeaturesNav" Content="Features" />
            <Button x:Name="HotKeysNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnHotKeysNav" Content="Hotkeys" />
            <Button x:Name="BackupNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnBackupNav" Content="Backup" />
            <Button x:Name="AboutNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnAboutNav" Content="About" />
        </StackPanel>
        <ScrollViewer Grid.Column="1" Padding="28,18,28,32">
            <Grid>
                <StackPanel x:Name="GeneralPane" Spacing="16">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="General" />
                    <Border Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                        <StackPanel>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Appearance" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="Dark is the design. Light inverts the ink." />
                                </StackPanel>
                                <ComboBox x:Name="AppearanceBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnAppearanceChanged" Width="140">
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="System" Tag="System" />
                                </ComboBox>
                            </Grid>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Launch at login" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="Start with Windows from the current user Run key." />
                                </StackPanel>
                                <ToggleSwitch x:Name="LaunchSwitch" Grid.Column="1" VerticalAlignment="Center" OffContent="" OnContent="" Toggled="OnLaunchToggled" />
                            </Grid>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Show in tray" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="The tray icon. Alt+Space still summons the palette." />
                                </StackPanel>
                                <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" VerticalAlignment="Center" OffContent="" OnContent="" Toggled="OnTrayToggled" />
                            </Grid>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Background transparency" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="Tint over acrylic. Center is the original 40% scrim." />
                                </StackPanel>
                                <Slider x:Name="TransparencySlider" Grid.Column="1" Width="160" VerticalAlignment="Center" Maximum="100" Minimum="-100" StepFrequency="50" TickFrequency="50" TickPlacement="Outside" ValueChanged="OnTransparencyChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PermissionsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Permissions" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Grants are requested from the gesture that needs them. Calendar uses AppointmentStore. Camera uses MediaCapture. Menu search reads classic Win32 menus. Double-tap and snippet keywords use a keyboard hook only while those bindings exist." />
                    <Button Click="OnRequestCalendar" Content="Request calendar access" />
                </StackPanel>

                <StackPanel x:Name="FeaturesPane" Spacing="16" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Features" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                        <StackPanel>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Clipboard history" /><TextBlock FontSize="12" Opacity="0.6" Text="Capture copies into SQLite FTS. Tab rings here." /></StackPanel><ToggleSwitch x:Name="ClipboardSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Window management" /><TextBlock FontSize="12" Opacity="0.6" Text="35 placement commands. No Stage Manager." /></StackPanel><ToggleSwitch x:Name="WindowSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="File search" /><TextBlock FontSize="12" Opacity="0.6" Text="Type D, Enter, then filter folders under that volume." /></StackPanel><ToggleSwitch x:Name="FileSearchSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notes" /><TextBlock FontSize="12" Opacity="0.6" Text="Floating markdown files." /></StackPanel><ToggleSwitch x:Name="NotesSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quicklinks" /><TextBlock FontSize="12" Opacity="0.6" Text="Saved URLs and paths." /></StackPanel><ToggleSwitch x:Name="QuicklinksSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Custom commands" /><TextBlock FontSize="12" Opacity="0.6" Text="Launch local executables." /></StackPanel><ToggleSwitch x:Name="CustomSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Navigation" /><TextBlock FontSize="12" Opacity="0.6" Text="Window switcher and layouts." /></StackPanel><ToggleSwitch x:Name="NavSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Snippets" /><TextBlock FontSize="12" Opacity="0.6" Text="Consent to expand text. Not carried in backups." /></StackPanel><ToggleSwitch x:Name="SnippetsSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AI chat" /><TextBlock FontSize="12" Opacity="0.6" Text="HTTPS chat. Off by default. Key stays in Credential Locker." /></StackPanel><ToggleSwitch x:Name="AiSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Calendar" /><TextBlock FontSize="12" Opacity="0.6" Text="Upcoming events and meeting links." /></StackPanel><ToggleSwitch x:Name="CalendarSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Auto-join meetings" /><TextBlock FontSize="12" Opacity="0.6" Text="Opens a detected link near start time." /></StackPanel><ToggleSwitch x:Name="AutoJoinSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Camera preview" /><TextBlock FontSize="12" Opacity="0.6" Text="Turns the camera on when you open Camera." /></StackPanel><ToggleSwitch x:Name="CameraSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MCP" /><TextBlock FontSize="12" Opacity="0.6" Text="Local stdio servers. Untrusted specs never start." /></StackPanel><ToggleSwitch x:Name="McpSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quick Actions" /><TextBlock FontSize="12" Opacity="0.6" Text="Reads the current selection when the palette opens." /></StackPanel><ToggleSwitch x:Name="QuickActionsSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                            <Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Extensions" /><TextBlock FontSize="12" Opacity="0.6" Text="Raycast JS extensions are deferred." /></StackPanel><ToggleSwitch x:Name="ExtensionsSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnFeatureToggled" /></Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="File search folders" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="One folder per line. Empty uses your user profile. Shipped ignore names (node_modules, build, dist, target, DerivedData, Pods) always apply." />
                    <TextBox x:Name="FileSearchScopesBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="D:\&#x0a;%USERPROFILE%\Documents" LostFocus="OnFileSearchPolicyChanged" />
                    <TextBox x:Name="FileSearchIgnoreBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" PlaceholderText="Extra names to ignore, one per line" LostFocus="OnFileSearchPolicyChanged" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="AI endpoint" />
                    <PasswordBox x:Name="AiKeyBox" PlaceholderText="API key (Credential Locker)" />
                    <TextBox x:Name="AiModelBox" PlaceholderText="Model" />
                    <TextBox x:Name="AiEndpointBox" PlaceholderText="HTTPS endpoint" />
                    <Button Click="OnSaveAi" Content="Save AI key" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="OpenCode (subscriptions)" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Install OpenCode, then run `opencode auth login`. Leave Server URL blank to spawn locally. Uses your OpenCode logins (ChatGPT, Copilot, Duo, Zen) — no keys leave OpenCode." />
                    <TextBox x:Name="OpenCodeBinaryBox" PlaceholderText="Binary path (opencode)" />
                    <TextBox x:Name="OpenCodeUrlBox" PlaceholderText="Server URL (blank = spawn local)" />
                    <PasswordBox x:Name="OpenCodePasswordBox" PlaceholderText="Server password (Credential Locker, optional)" />
                    <TextBox x:Name="OpenCodeModelBox" PlaceholderText="Model provider/model (e.g. openai/gpt-5)" />
                    <TextBlock x:Name="OpenCodeStatus" Opacity="0.7" TextWrapping="Wrap" Text="OpenCode status unknown." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSaveOpenCode" Content="Save OpenCode" />
                        <Button Click="OnRefreshOpenCode" Content="Refresh provider status" />
                    </StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Snippets" />
                    <TextBox x:Name="SnippetNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="SnippetKeywordBox" PlaceholderText="Keyword" />
                    <TextBox x:Name="SnippetTextBox" AcceptsReturn="True" PlaceholderText="Template ({date}, {clipboard}, {cursor})" />
                    <Button Click="OnAddSnippet" Content="Add snippet" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Quicklinks" />
                    <TextBox x:Name="LinkNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="LinkDestBox" PlaceholderText="URL or path" />
                    <Button Click="OnAddQuicklink" Content="Add quicklink" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Custom commands" />
                    <TextBox x:Name="CmdNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="CmdFileBox" PlaceholderText="Executable path" />
                    <Button Click="OnAddCustom" Content="Add command" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Aliases and visibility" />
                    <TextBox x:Name="AliasIdBox" PlaceholderText="Item id (app:… or command:…)" />
                    <TextBox x:Name="AliasTextBox" PlaceholderText="User alias" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnAddAlias" Content="Set alias" />
                        <Button Click="OnHideItem" Content="Hide item" />
                        <Button Click="OnShowItem" Content="Unhide item" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="HotKeysPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Hotkeys" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Alt+Space always toggles the palette. Extra chords register on the palette HWND. Double-tap uses a keyboard hook. Hyper is Ctrl+Alt+Shift+Win. Recording pauses existing hotkeys." />
                    <ListView x:Name="HotKeyList" Height="180" />
                    <ComboBox x:Name="HotKeyCommandBox" Width="280" HorizontalAlignment="Left" />
                    <TextBox x:Name="HotKeyAppBox" PlaceholderText="Optional app path or process name" />
                    <ComboBox x:Name="DoubleTapBox" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="No double-tap" Tag="" />
                        <ComboBoxItem Content="Double Ctrl" Tag="Control" />
                        <ComboBoxItem Content="Double Alt" Tag="Alt" />
                        <ComboBoxItem Content="Double Shift" Tag="Shift" />
                        <ComboBoxItem Content="Double Win" Tag="Win" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRecordHotKey" Content="Record chord" />
                        <Button Click="OnAddHotKey" Content="Add binding" />
                        <Button Click="OnRemoveHotKey" Content="Remove selected" />
                    </StackPanel>
                    <TextBlock x:Name="HotKeyStatus" Opacity="0.7" />
                </StackPanel>

                <StackPanel x:Name="BackupPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Backup" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Archives can carry appearance, clipboard, snippets, notes, and ranking. Capability flags (AI, calendar, snippets listening, MCP, extensions, camera, auto-join, quick actions) are never imported." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnExportBackup" Content="Export .tinycast" />
                        <Button Click="OnImportBackup" Content="Import" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AboutPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="About" />
                    <TextBlock x:Name="AboutIdentity" />
                    <TextBlock x:Name="AboutMcp" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Updates come from GitHub Releases. A private repo needs a personal access token (repo scope). The token stays in Credential Locker and is never backed up." />
                    <PasswordBox x:Name="GitHubTokenBox" PlaceholderText="GitHub token for private releases" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSaveGitHubToken" Content="Save GitHub token" />
                        <Button Click="OnCheckUpdates" Content="Check for updates" />
                        <Button Click="OnOpenSupport" Content="Support" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
