<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tinycast.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="231" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Padding="10,12,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="SettingsSearch"
                Margin="0,0,16,8"
                PlaceholderText="Search"
                TextChanged="OnSettingsSearch" />
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SidebarHost" Margin="0,0,16,0" Spacing="2" />
            </ScrollViewer>
        </Grid>
        <Border
            Width="1"
            HorizontalAlignment="Right"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <ScrollViewer Grid.Column="1" Padding="28,18,28,32">
            <Grid>
                <StackPanel x:Name="GeneralPane" Spacing="16">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="General" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                        <StackPanel>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Appearance" VerticalAlignment="Center" />
                                <ComboBox x:Name="AppearanceBox" Grid.Column="1" Width="140" SelectionChanged="OnAppearanceChanged">
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="System" Tag="System" />
                                </ComboBox>
                            </Grid>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Launch at login" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="LaunchSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnLaunchToggled" />
                            </Grid>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show in tray" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnTrayToggled" />
                            </Grid>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Background transparency" VerticalAlignment="Center" />
                                <Slider x:Name="TransparencySlider" Grid.Column="1" Width="160" Maximum="100" Minimum="-100" StepFrequency="50" TickFrequency="50" ValueChanged="OnTransparencyChanged" />
                            </Grid>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interface size" VerticalAlignment="Center" />
                                <ComboBox x:Name="InterfaceSizeBox" Grid.Column="1" Width="140" SelectionChanged="OnInterfaceSizeChanged">
                                    <ComboBoxItem Content="Compact" Tag="compact" />
                                    <ComboBoxItem Content="Standard" Tag="standard" />
                                    <ComboBoxItem Content="Large" Tag="large" />
                                </ComboBox>
                            </Grid>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Compact palette" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="CompactPaletteSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnPaletteChromeChanged" />
                            </Grid>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Remember palette position" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="RememberPositionSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnPaletteChromeChanged" />
                            </Grid>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Escape clears the query first" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="EscapeClearsSwitch" Grid.Column="1" OffContent="" OnContent="" Toggled="OnPaletteChromeChanged" />
                            </Grid>
                            <Grid Padding="14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pop to root after (seconds, 0 = immediately)" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <NumberBox x:Name="PopToRootBox" Grid.Column="1" Width="100" Maximum="120" Minimum="0" SpinButtonPlacementMode="Inline" ValueChanged="OnPopToRootChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PermissionsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Permissions" />
                    <TextBlock x:Name="PermissionsStatus" TextWrapping="Wrap" Opacity="0.7" />
                    <Button Click="OnRequestCalendar" Content="Request calendar access" HorizontalAlignment="Left" />
                    <Button Click="OnOpenPrivacyCalendar" Content="Open Calendar privacy" HorizontalAlignment="Left" />
                    <Button Click="OnOpenPrivacyCamera" Content="Open Camera privacy" HorizontalAlignment="Left" />
                    <Button Click="OnOpenPrivacyMicrophone" Content="Open Microphone privacy" HorizontalAlignment="Left" />
                    <Button Click="OnOpenWindowsSettings" Content="Open Windows Settings" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel x:Name="HotkeysPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Hotkeys" />
                    <ListView x:Name="HotKeyList" Height="180" />
                    <ComboBox x:Name="HotKeyCommandBox" Width="280" HorizontalAlignment="Left" />
                    <TextBox x:Name="HotKeyAppBox" PlaceholderText="Optional app path" />
                    <ComboBox x:Name="DoubleTapBox" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="No double-tap" Tag="" />
                        <ComboBoxItem Content="Double Ctrl" Tag="Control" />
                        <ComboBoxItem Content="Double Alt" Tag="Alt" />
                        <ComboBoxItem Content="Double Shift" Tag="Shift" />
                        <ComboBoxItem Content="Double Win" Tag="Win" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRecordHotKey" Content="Record chord" />
                        <Button Click="OnRecordSelectedHotKey" Content="Rebind selected" />
                        <Button Click="OnAddHotKey" Content="Add binding" />
                        <Button Click="OnRemoveHotKey" Content="Remove selected" />
                    </StackPanel>
                    <TextBlock x:Name="HotKeyStatus" Opacity="0.7" />
                </StackPanel>

                <StackPanel x:Name="ApplicationsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Applications" />
                    <TextBox x:Name="ApplicationsFilter" PlaceholderText="Filter" TextChanged="OnApplicationsFilter" />
                    <ListView x:Name="ApplicationsList" Height="320" SelectionChanged="OnApplicationSelected" />
                    <TextBox x:Name="ApplicationAliasBox" PlaceholderText="Alias" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSetApplicationAlias" Content="Set alias" />
                        <Button Click="OnHideApplication" Content="Hide" />
                        <Button Click="OnShowApplication" Content="Unhide" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SystemSettingsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="System Settings" />
                    <ListView x:Name="SystemSettingsList" Height="400" />
                </StackPanel>

                <StackPanel x:Name="SystemActionsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="System Actions" />
                    <ListView x:Name="SystemActionsList" Height="400" />
                </StackPanel>

                <StackPanel x:Name="CommandsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Commands" />
                    <ToggleSwitch x:Name="CustomSwitch" OffContent="" OnContent="" Header="Custom commands" Toggled="OnFeatureToggled" />
                    <ToggleSwitch x:Name="CustomShowSwitch" OffContent="" OnContent="" Header="Show in launcher" Toggled="OnFeatureToggled" />
                    <ListView x:Name="CustomCommandsList" Height="200" SelectionChanged="OnCustomSelected" />
                    <TextBox x:Name="CmdNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="CmdFileBox" PlaceholderText="Command text or executable path" />
                    <TextBox x:Name="CmdArgsBox" PlaceholderText="Static arguments, space-separated (never spliced)" />
                    <TextBox x:Name="CmdCwdBox" PlaceholderText="Working folder (blank = home)" />
                    <TextBox x:Name="CmdParamsBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" PlaceholderText="Prompts, one per line" />
                    <ToggleSwitch x:Name="CmdEnabledSwitch" OffContent="" OnContent="" Header="Enabled" />
                    <ToggleSwitch x:Name="CmdConfirmSwitch" OffContent="" OnContent="" Header="Confirm before running" />
                    <ToggleSwitch x:Name="CmdOutputSwitch" OffContent="" OnContent="" Header="Show output" />
                    <ToggleSwitch x:Name="CmdEnvSwitch" OffContent="" OnContent="" Header="Load shell environment" />
                    <ToggleSwitch x:Name="CmdHudSwitch" OffContent="" OnContent="" Header="Show confirmation HUD" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnAddCustom" Content="Save" />
                        <Button Click="OnRemoveCustom" Content="Remove selected" />
                        <Button Click="OnImportCommandScript" Content="Import script" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="QuicklinksPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Quicklinks" />
                    <ToggleSwitch x:Name="QuicklinksSwitch" OffContent="" OnContent="" Header="Enable Quicklinks" Toggled="OnFeatureToggled" />
                    <ListView x:Name="QuicklinksList" Height="200" />
                    <TextBox x:Name="LinkNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="LinkDestBox" PlaceholderText="URL or path ({argument} {selection} {clipboard} {date})" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnAddQuicklink" Content="Add" />
                        <Button Click="OnRemoveQuicklink" Content="Remove selected" />
                        <Button Click="OnExportQuicklinks" Content="Export" />
                        <Button Click="OnImportQuicklinks" Content="Import" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="FallbacksPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Fallbacks" />
                    <ListView x:Name="FallbacksList" Height="280" SelectionMode="Single" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnToggleFallback" Content="Enable / disable" />
                        <Button Click="OnMoveFallbackUp" Content="Move up" />
                        <Button Click="OnMoveFallbackDown" Content="Move down" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AiPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="AI" />
                    <ToggleSwitch x:Name="AiSwitch" OffContent="" OnContent="" Header="Enable AI" Toggled="OnFeatureToggled" />
                    <PasswordBox x:Name="AiKeyBox" PlaceholderText="API key" />
                    <TextBox x:Name="AiModelBox" PlaceholderText="Model" />
                    <TextBox x:Name="AiEndpointBox" PlaceholderText="HTTPS endpoint" />
                    <Button Click="OnSaveAi" Content="Save AI key" HorizontalAlignment="Left" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="OpenCode" />
                    <TextBox x:Name="OpenCodeBinaryBox" PlaceholderText="Binary path" />
                    <TextBox x:Name="OpenCodeUrlBox" PlaceholderText="Server URL" />
                    <PasswordBox x:Name="OpenCodePasswordBox" PlaceholderText="Server password" />
                    <TextBox x:Name="OpenCodeModelBox" PlaceholderText="provider/model" />
                    <TextBlock x:Name="OpenCodeStatus" Opacity="0.7" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSaveOpenCode" Content="Save OpenCode" />
                        <Button Click="OnRefreshOpenCode" Content="Refresh" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="QuickActionsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Quick Actions" />
                    <ToggleSwitch x:Name="QuickActionsSwitch" OffContent="" OnContent="" Header="Enable Quick Actions" Toggled="OnFeatureToggled" />
                </StackPanel>

                <StackPanel x:Name="FileSearchPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="File Search" />
                    <ToggleSwitch x:Name="FileSearchSwitch" OffContent="" OnContent="" Header="Enable File Search" Toggled="OnFeatureToggled" />
                    <TextBox x:Name="FileSearchScopesBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Folders, one per line" LostFocus="OnFileSearchPolicyChanged" />
                    <TextBox x:Name="FileSearchIgnoreBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" PlaceholderText="Ignore names" LostFocus="OnFileSearchPolicyChanged" />
                </StackPanel>

                <StackPanel x:Name="NotesPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Notes" />
                    <ToggleSwitch x:Name="NotesSwitch" OffContent="" OnContent="" Header="Enable Notes" Toggled="OnFeatureToggled" />
                    <TextBlock Opacity="0.7" Text="Notes stay off until you enable them." />
                    <Button Click="OnOpenNotes" Content="Open notes" HorizontalAlignment="Left" />
                    <Button Click="OnRevealNotes" Content="Reveal notes folder" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel x:Name="SnippetsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Snippets" />
                    <ToggleSwitch x:Name="SnippetsSwitch" OffContent="" OnContent="" Header="Enable snippets" Toggled="OnFeatureToggled" />
                    <ToggleSwitch x:Name="SnippetsShowSwitch" OffContent="" OnContent="" Header="Show in launcher" Toggled="OnFeatureToggled" />
                    <ListView x:Name="SnippetsList" Height="160" SelectionChanged="OnSnippetSelected" />
                    <TextBox x:Name="SnippetNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="SnippetKeywordBox" PlaceholderText="Keyword" />
                    <TextBox x:Name="SnippetTextBox" AcceptsReturn="True" Height="100" TextWrapping="Wrap" PlaceholderText="Template. Markdown files with frontmatter also load from the snippets folder." />
                    <ToggleSwitch x:Name="SnippetEnabledSwitch" OffContent="" OnContent="" Header="Enabled" />
                    <ToggleSwitch x:Name="SnippetConfirmSwitch" OffContent="" OnContent="" Header="Show confirmation" />
                    <TextBlock x:Name="SnippetConflictText" TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSaveSnippet" Content="Save" />
                        <Button Click="OnRemoveSnippet" Content="Delete" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NavigationPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Navigation" />
                    <ToggleSwitch x:Name="NavSwitch" OffContent="" OnContent="" Header="Enable navigation" Toggled="OnFeatureToggled" />
                    <TextBox x:Name="NavExcludedBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Excluded process names, one per line" LostFocus="OnNavigationExcludedChanged" />
                </StackPanel>

                <StackPanel x:Name="WindowManagementPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Window Management" />
                    <ToggleSwitch x:Name="WindowSwitch" OffContent="" OnContent="" Header="Enable window management" Toggled="OnFeatureToggled" />
                    <ToggleSwitch x:Name="LayoutsShowSwitch" OffContent="" OnContent="" Header="Show layouts in launcher" Toggled="OnFeatureToggled" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gap" VerticalAlignment="Center" />
                        <Slider x:Name="GapSlider" Grid.Column="1" Width="160" Maximum="64" Minimum="0" StepFrequency="1" ValueChanged="OnGapChanged" />
                    </Grid>
                    <ComboBox x:Name="CycleBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnCycleChanged">
                        <ComboBoxItem Content="No cycling" Tag="Off" />
                        <ComboBoxItem Content="Halves and thirds" Tag="Sizes" />
                        <ComboBoxItem Content="Displays" Tag="Displays" />
                    </ComboBox>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Layouts" />
                    <ListView x:Name="LayoutsList" Height="140" SelectionChanged="OnLayoutSelected" />
                    <TextBox x:Name="LayoutNameBox" PlaceholderText="Name" />
                    <TextBox x:Name="LayoutSlotsBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="process  x  y  width  height  [path]" />
                    <ComboBox x:Name="LayoutAnchorBox" Width="220" HorizontalAlignment="Left" Header="3×3 anchor">
                        <ComboBoxItem Content="Top left" Tag="top-left" />
                        <ComboBoxItem Content="Top" Tag="top" />
                        <ComboBoxItem Content="Top right" Tag="top-right" />
                        <ComboBoxItem Content="Left" Tag="left" />
                        <ComboBoxItem Content="Center" Tag="center" />
                        <ComboBoxItem Content="Right" Tag="right" />
                        <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
                        <ComboBoxItem Content="Bottom" Tag="bottom" />
                        <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
                    </ComboBox>
                    <NumberBox x:Name="LayoutWidthBox" Header="Width fraction" Maximum="1" Minimum="0.01" SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                    <NumberBox x:Name="LayoutHeightBox" Header="Height fraction" Maximum="1" Minimum="0.01" SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnCaptureLayout" Content="Capture" />
                        <Button Click="OnSaveLayoutEdit" Content="Save" />
                        <Button Click="OnDeleteLayout" Content="Delete" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ClipboardPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Clipboard" />
                    <ToggleSwitch x:Name="ClipboardSwitch" OffContent="" OnContent="" Header="Enable Clipboard History" Toggled="OnFeatureToggled" />
                    <TextBlock x:Name="ClipboardFilterHint" Opacity="0.7" />
                    <ToggleSwitch x:Name="ClipboardOcrSwitch" OffContent="" OnContent="" Header="OCR images (opt-in)" Toggled="OnClipboardPolicyChanged" />
                    <ToggleSwitch x:Name="ClipboardKeepOpenSwitch" OffContent="" OnContent="" Header="Keep palette open after paste" Toggled="OnClipboardPolicyChanged" />
                    <ComboBox x:Name="ClipboardActionBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnClipboardActionChanged">
                        <ComboBoxItem Content="Paste by default" Tag="paste" />
                        <ComboBoxItem Content="Copy by default" Tag="copy" />
                    </ComboBox>
                    <NumberBox x:Name="ClipboardRetentionBox" Header="Retention days (0 keeps forever)" Maximum="3650" Minimum="0" SpinButtonPlacementMode="Inline" ValueChanged="OnClipboardRetentionChanged" />
                    <TextBox x:Name="ClipboardIgnoredBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Ignored app names, one per line" LostFocus="OnClipboardPolicyChanged" />
                </StackPanel>

                <StackPanel x:Name="EmojiPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Emoji &amp; Symbols" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Columns" VerticalAlignment="Center" />
                        <Slider x:Name="EmojiColumnsSlider" Grid.Column="1" Width="160" Maximum="10" Minimum="6" StepFrequency="1" ValueChanged="OnEmojiColumnsChanged" />
                    </Grid>
                    <ComboBox x:Name="EmojiSkinBox" Width="220" HorizontalAlignment="Left" Header="Skin tone" SelectionChanged="OnEmojiSkinChanged">
                        <ComboBoxItem Content="Default" Tag="0" />
                        <ComboBoxItem Content="Light" Tag="1" />
                        <ComboBoxItem Content="Medium-light" Tag="2" />
                        <ComboBoxItem Content="Medium" Tag="3" />
                        <ComboBoxItem Content="Medium-dark" Tag="4" />
                        <ComboBoxItem Content="Dark" Tag="5" />
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="CalendarPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Calendar" />
                    <ToggleSwitch x:Name="CalendarSwitch" OffContent="" OnContent="" Header="Enable Calendar" Toggled="OnFeatureToggled" />
                    <ToggleSwitch x:Name="AutoJoinSwitch" OffContent="" OnContent="" Header="Auto-join meetings" Toggled="OnFeatureToggled" />
                    <ToggleSwitch x:Name="CameraSwitch" OffContent="" OnContent="" Header="Camera preview" Toggled="OnFeatureToggled" />
                    <TextBox x:Name="CalendarExcludedBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Excluded calendar IDs, one per line" LostFocus="OnCalendarExcludedChanged" />
                </StackPanel>

                <StackPanel x:Name="ExtensionsPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Extensions" />
                    <ToggleSwitch x:Name="ExtensionsSwitch" OffContent="" OnContent="" Header="Enable Extensions" Toggled="OnFeatureToggled" />
                    <ToggleSwitch x:Name="McpSwitch" OffContent="" OnContent="" Header="MCP" Toggled="OnFeatureToggled" />
                </StackPanel>

                <StackPanel x:Name="BackupPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Backup" />
                    <CheckBox x:Name="BackupSettingsCheck" Content="Settings and shortcuts" IsChecked="True" />
                    <CheckBox x:Name="BackupSnippetsCheck" Content="Snippets" IsChecked="True" />
                    <CheckBox x:Name="BackupNotesCheck" Content="Notes" IsChecked="True" />
                    <CheckBox x:Name="BackupLearningCheck" Content="Launcher learning" IsChecked="True" />
                    <CheckBox x:Name="BackupClipboardCheck" Content="Clipboard history" IsChecked="True" />
                    <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnExportBackup" Content="Export .tinycast" />
                        <Button Click="OnImportBackup" Content="Import" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AboutPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="About" />
                    <TextBlock x:Name="AboutIdentity" FontSize="16" />
                    <TextBlock x:Name="AboutMcp" Visibility="Collapsed" TextWrapping="Wrap" />
                    <TextBlock x:Name="AboutUpdateStatus" TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdatesButton" Click="OnUpdatesButton" Content="Check for updates" />
                        <Button Click="OnOpenSupport" Content="Support" />
                        <Button Click="OnReplayOnboarding" Content="Welcome" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
