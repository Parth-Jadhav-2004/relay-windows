<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tinycast.NotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Notes">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Notes" />
        <ListView
            x:Name="FileList"
            Grid.Row="1"
            SelectionChanged="OnSelectionChanged" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Click="OnNew" Content="New" />
            <Button Click="OnDelete" Content="Delete" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
            <TextBox x:Name="TitleBox" PlaceholderText="Title" />
        </StackPanel>
        <TextBox
            x:Name="BodyBox"
            Grid.Column="1"
            Grid.Row="1"
            AcceptsReturn="True"
            PlaceholderText="Markdown"
            TextWrapping="Wrap" />
        <Button
            Grid.Column="1"
            Grid.Row="2"
            HorizontalAlignment="Right"
            Click="OnSave"
            Content="Save" />
    </Grid>
</Window>
