<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Relay.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Width="420" KeyDown="OnKeyDown">
        <Border x:Name="Scrim" />
        <StackPanel Padding="20" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon x:Name="Glyph" FontSize="32" />
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleBlock" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageBlock" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="Buttons" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" />
        </StackPanel>
    </Grid>
</Window>
